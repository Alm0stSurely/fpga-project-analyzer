{
  "about": "Probe -> fpa node table for the activity highlight. 'fpa' is the instance path as fpa names it (generate scopes dropped); 'rtl' is the elaborated path (GHDL/Verilator, with generate scopes). 'probes' are names from neo_probe_names() (counters of the last step); the block's activity is their sum divided by the cycles in the window. 'widget' is the sim-panel element a click on the block focuses. build.sh checks every 'fpa' path against design.html and against the GHDL-elaborated tree and writes the checked copy to fpa-map.json.",
  "entries": [
    {"id": "cpu", "label": "CPU", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/core_complex_inst/cpu_inst",
     "rtl": "/neorv32_top_inst/core_complex_gen(0)/core_complex_inst/cpu_inst",
     "probes": ["cpu_ifetch", "cpu_dacc"], "what": "instruction fetches + loads/stores (cpu ibus/dbus stb)"},
    {"id": "cpu_frontend", "label": "CPU front end", "widget": "stats",
     "fpa": "/neorv32_top_inst/core_complex_inst/cpu_inst/cpu_frontend_inst",
     "rtl": "/neorv32_top_inst/core_complex_gen(0)/core_complex_inst/cpu_inst/cpu_frontend_inst",
     "probes": ["cpu_ifetch"], "what": "instruction fetches (ibus stb)"},
    {"id": "cpu_lsu", "label": "CPU load/store unit", "widget": "stats",
     "fpa": "/neorv32_top_inst/core_complex_inst/cpu_inst/cpu_lsu_inst",
     "rtl": "/neorv32_top_inst/core_complex_gen(0)/core_complex_inst/cpu_inst/cpu_lsu_inst",
     "probes": ["cpu_dacc"], "what": "loads/stores (dbus stb)"},
    {"id": "core_bus_switch", "label": "Core bus switch", "widget": "stats",
     "fpa": "/neorv32_top_inst/core_complex_inst/bus_switch_inst",
     "rtl": "/neorv32_top_inst/core_complex_gen(0)/core_complex_inst/bus_switch_inst",
     "probes": ["cpu_ifetch", "cpu_dacc"], "what": "merges the CPU's instruction and data buses"},
    {"id": "bus", "label": "Bus gateway", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/bus_gateway_inst",
     "rtl": "/neorv32_top_inst/bus_gateway_inst",
     "probes": ["imem", "dmem", "bootrom", "uart0", "gpio", "clint", "sysinfo"], "what": "every request it routes to IMEM, DMEM or the IO switch"},
    {"id": "io_switch", "label": "IO bus switch", "widget": "stats",
     "fpa": "/neorv32_top_inst/bus_io_switch_inst",
     "rtl": "/neorv32_top_inst/io_system/bus_io_switch_inst",
     "probes": ["bootrom", "uart0", "gpio", "clint", "sysinfo"], "what": "requests to the boot ROM and the IO devices"},
    {"id": "imem", "label": "IMEM (16 KiB)", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/imem_inst",
     "rtl": "/neorv32_top_inst/memory_system/imem_enabled/imem_inst",
     "probes": ["imem"], "what": "IMEM requests (req_stb_i)"},
    {"id": "imem_ram", "label": "IMEM RAM", "widget": "stats",
     "fpa": "/neorv32_top_inst/imem_inst/imem_ram_inst",
     "rtl": "/neorv32_top_inst/memory_system/imem_enabled/imem_inst/imem_ram/imem_ram_gen(0..3)/imem_ram_inst",
     "probes": ["imem"], "what": "IMEM requests"},
    {"id": "dmem", "label": "DMEM (8 KiB)", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/dmem_inst",
     "rtl": "/neorv32_top_inst/memory_system/dmem_enabled/dmem_inst",
     "probes": ["dmem"], "what": "DMEM requests (req_stb_i)"},
    {"id": "dmem_ram", "label": "DMEM RAM", "widget": "stats",
     "fpa": "/neorv32_top_inst/dmem_inst/dmem_ram",
     "rtl": "/neorv32_top_inst/memory_system/dmem_enabled/dmem_inst/dmem_ram_gen(0..3)/dmem_ram",
     "probes": ["dmem"], "what": "DMEM requests"},
    {"id": "bootrom", "label": "Boot ROM", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/boot_rom_inst",
     "rtl": "/neorv32_top_inst/io_system/bootrom_enabled/boot_rom_inst",
     "probes": ["bootrom"], "what": "boot ROM requests (req_stb_i)"},
    {"id": "bootrom_read", "label": "Boot ROM read", "widget": "stats",
     "fpa": "/neorv32_top_inst/boot_rom_inst/rom_access",
     "rtl": "/neorv32_top_inst/io_system/bootrom_enabled/boot_rom_inst",
     "probes": ["bootrom"], "what": "boot ROM requests"},
    {"id": "uart0", "label": "UART0", "primary": true, "widget": "terminal",
     "fpa": "/neorv32_top_inst/uart0_inst",
     "rtl": "/neorv32_top_inst/io_system/uart0_enabled/uart0_inst",
     "probes": ["uart0", "uart_tx_busy", "uart_rx_busy"], "what": "register accesses + cycles the TX/RX engines are shifting"},
    {"id": "uart0_tx", "label": "UART0 transmitter", "widget": "terminal",
     "fpa": "/neorv32_top_inst/uart0_inst/transmitter",
     "rtl": "/neorv32_top_inst/io_system/uart0_enabled/uart0_inst (process transmitter)",
     "probes": ["uart_tx_busy"], "what": "cycles the TX engine is shifting (tx.state = 11)"},
    {"id": "uart0_rx", "label": "UART0 receiver", "widget": "terminal",
     "fpa": "/neorv32_top_inst/uart0_inst/receiver",
     "rtl": "/neorv32_top_inst/io_system/uart0_enabled/uart0_inst (process receiver)",
     "probes": ["uart_rx_busy"], "what": "cycles the RX engine is shifting (rx.state = 11)"},
    {"id": "gpio", "label": "GPIO", "primary": true, "widget": "leds",
     "fpa": "/neorv32_top_inst/gpio_inst",
     "rtl": "/neorv32_top_inst/io_system/gpio_enabled/gpio_inst",
     "probes": ["gpio", "gpio_toggles"], "what": "register accesses + gpio_o changes"},
    {"id": "clint", "label": "CLINT (timer)", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/clint_inst",
     "rtl": "/neorv32_top_inst/io_system/clint_enabled/clint_inst",
     "probes": ["clint", "mti"], "what": "register accesses + cycles with the timer interrupt pending"},
    {"id": "clint_mtimecmp", "label": "CLINT mtimecmp", "widget": "stats",
     "fpa": "/neorv32_top_inst/clint_inst/neorv32_clint_mtimecmp_inst",
     "rtl": "/neorv32_top_inst/io_system/clint_enabled/clint_inst/neorv32_clint_mtimecmp_gen(0)/neorv32_clint_mtimecmp_inst",
     "probes": ["mti"], "what": "cycles with the timer interrupt pending"},
    {"id": "sysinfo", "label": "SYSINFO", "primary": true, "widget": "stats",
     "fpa": "/neorv32_top_inst/sysinfo_inst",
     "rtl": "/neorv32_top_inst/io_system/sysinfo_inst",
     "probes": ["sysinfo"], "what": "register accesses"}
  ]
}
